{
  "name": "dsh-replay-reset",
  "version": "0.1.3",
  "description": "处理 AgentRouter Responses 旧会话续聊时的资源绑定报错；手动重置旧回放，保留聊天历史。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PopCorey/dsh-replay-reset.git"
  },
  "homepage": "https://github.com/PopCorey/dsh-replay-reset#readme",
  "bugs": {"url": "https://github.com/PopCorey/dsh-replay-reset/issues"},
  "keywords": ["dsh-plugin", "dsh", "responses", "session"],
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["src", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "CONTRIBUTING.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:unit": "node scripts/test.mjs --unit",
    "check:package": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {"node": ">=24", "dsh": "0.2.2-rc.1"},
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.1",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {"optional": true},
    "@deepseek-ai/dsh-llm": {"optional": true},
    "@deepseek-ai/dsh-session": {"optional": true},
    "@deepseek-ai/dsh-storage-domain": {"optional": true},
    "zod": {"optional": true}
  },
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-ui-session", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-resources"]
    }
  },
  "license": "MIT"
}
